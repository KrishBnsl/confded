{
  "manifest_version": 3,
  "name": "CS Conference Deadlines",
  "version": "0.2.0",
  "description": "Countdown popup, toolbar badge and reminders for computer-science conference deadlines, refreshed daily from the open CCFDDL dataset.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://ccfddl.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CS conference deadlines"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
